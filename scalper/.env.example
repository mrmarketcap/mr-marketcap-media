# کپی کنید به .env  (هرگز commit نکنید)
EXCHANGE=okx
API_KEY=
API_SECRET=
API_PASSPHRASE=        # OKX حتما passphrase می‌خواهد
# SANDBOX=1 => OKX Demo Trading (کلید API جداگانه از بخش Demo trading بسازید)
SANDBOX=1
# MODE: paper (شبیه‌سازی با قیمت واقعی) | live (سفارش واقعی)
MODE=paper
SYMBOL=BNB/USDT:USDT   # پرپچوال USDT-margined
TIMEFRAME=1m
QUOTE_BUDGET=100        # مارجینی که بات اجازه دارد استفاده کند (USDT)
RISK_PER_TRADE=0.005    # ریسک هر معامله = 0.5% از بودجه
MAX_DAILY_LOSS=0.02     # ۲٪ ضرر روزانه => توقف تا فردا
MAX_TRADES_PER_DAY=40
COOLDOWN_SEC=60
FEE_RATE=0.0005         # کارمزد taker فیوچرز OKX (~۰.۰۵٪ هر طرف)
LEVERAGE=3              # isolated margin
