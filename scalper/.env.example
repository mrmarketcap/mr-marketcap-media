# کپی کنید به .env  (هرگز commit نکنید)
EXCHANGE=binance
API_KEY=
API_SECRET=
# اول حتما روی testnet/sandbox تست کنید
SANDBOX=1
# MODE: paper (شبیه‌سازی با قیمت واقعی) | live (سفارش واقعی)
MODE=paper
SYMBOL=BTC/USDT
TIMEFRAME=1m
QUOTE_BUDGET=100        # سقف سرمایه‌ای که بات اجازه دارد استفاده کند (USDT)
RISK_PER_TRADE=0.005    # ریسک هر معامله = 0.5% از بودجه
MAX_DAILY_LOSS=0.02     # ۲٪ ضرر روزانه => توقف تا فردا
MAX_TRADES_PER_DAY=40
COOLDOWN_SEC=60
FEE_RATE=0.001          # کارمزد هر طرف (۰.۱٪ پیش‌فرض بایننس)
